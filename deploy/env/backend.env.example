# Backend hors profil dev (production) : toutes ces valeurs sont obligatoires, sauf mention contraire.
# Une valeur absente fait échouer le démarrage en nommant la propriété en cause (D-DD).

# Base de données. Sans profil, l'URL n'est pas construite depuis POSTGRES_* (réservé au profil dev).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Compte administrateur unique : appliqué à chaque démarrage (mot de passe : 15 caractères au moins, 72 octets au plus).
# Facultatif : les deux ou aucun ; aucun = administration fermée.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Médias : répertoire persistant des fichiers (volume), chemin absolu.
MEDIA_STORAGE_ROOT=

# SMTP (notifications de contact). MAIL_PORT : 587 par défaut.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Destinataire des notifications (l'administrateur)
MAIL_TO=

# Facultatif : journaux JSON (ECS) pour un agrégateur, avec requestId et version ; absent = texte lisible (D-DF).
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
